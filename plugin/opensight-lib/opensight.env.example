# OpenSight 配置 (插件启动时读取, 修改后需重启 opencode)
# 支持 VISION_ 前缀的环境变量; 系统环境变量优先级高于此文件
# 默认使用 opencode-go (https://opencode.ai/zen/go/v1), 密钥自动读取 OPENCODE_GO_API_KEY 或 VISION_API_KEY

VISION_API_BASE_URL=https://opencode.ai/zen/go/v1
VISION_MODELS=mimo-v2.5,qwen3.7-plus,qwen3.6-plus
VISION_API_KEY=
VISION_PYTHON=
VISION_OFFLINE=0
VISION_MAX_DIM=1568
VISION_OCR_MIN_CONFIDENCE=0.55
